# Install as a user-readable-only service environment file. Never commit the
# populated copy. Generate a long random value for OPENBENCH_SECRET_KEY.
OPENBENCH_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
OPENBENCH_ALLOWED_HOSTS=openbench.example.com
OPENBENCH_CSRF_TRUSTED_ORIGINS=https://openbench.example.com
OPENBENCH_DB_ENGINE=mysql
OPENBENCH_DB_NAME=openbench
OPENBENCH_DB_USER=openbench
OPENBENCH_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
OPENBENCH_DB_HOST=127.0.0.1
OPENBENCH_DB_PORT=3306
OPENBENCH_HTTPS=1
# Enable only after confirming that every subdomain is permanently HTTPS-ready.
OPENBENCH_HSTS_INCLUDE_SUBDOMAINS=0
OPENBENCH_HSTS_PRELOAD=0
